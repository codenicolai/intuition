{
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/custom-elements.json",
      "!e2e",
      "!**/*.generated.ts",
      "!snapshots",
      "!**/generated",
      "!**/*.svelte",
      "!**/.svelte-kit"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  }
}

{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "react": [
        "../../node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "../../node_modules/@types/react/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
